Algoritmo pago_horas_extra
	Definir horas,extra, sueldo Como Real
	Escribir "Cuantas horas trabajaste"
	Leer hora
	si hora > 42 Entonces
		extra <- horas-42
		pago<-42*8838
		sueldo<-extra*8838*1.5
		total<-pago+sueldo
		Escribir "el pago total es:" , total
	SiNo
		horasinextra<-42*8838
		Escribir "el pago total es:", horasinextra
	
		
		
	FinSi
	
FinAlgoritmo
